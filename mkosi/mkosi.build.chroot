#!/bin/bash
# Builds sommelier from ChromiumOS platform2 and carte-agent from vm_tools/carte/,
# and installs them to /usr/local/bin in the final image.
# Runs inside the image (with BuildPackages= overlaid), so it is compiled
# against the target distribution's own libraries.
set -euo pipefail

: "${SOMMELIER_REPO:=https://chromium.googlesource.com/chromiumos/platform2}"
: "${SOMMELIER_REF:=main}"

work="${BUILDDIR:-$(mktemp -d)}"
src="$work/platform2"

# platform2 is huge: fetch only vm_tools/sommelier.
if [[ ! -d "$src/.git" ]]; then
    git clone --depth=1 --filter=blob:none --sparse --no-checkout "$SOMMELIER_REPO" "$src"
    git -C "$src" sparse-checkout set vm_tools/sommelier
fi
git -C "$src" fetch --depth=1 origin "$SOMMELIER_REF"
git -C "$src" checkout --force FETCH_HEAD
echo "sommelier: building $(git -C "$src" rev-parse HEAD)"

rm -rf "$work/build"
meson setup "$work/build" "$src/vm_tools/sommelier" \
    --prefix=/usr/local \
    --buildtype=release \
    -Dwith_tests=false
meson compile -C "$work/build"
meson install -C "$work/build" --destdir "$DESTDIR"

# carte-agent. Cargo downloads the crates in Cargo.lock; with mkosi.builddir
# they and the build are kept between builds.
CARGO_HOME="$work/cargo" cargo build --release --locked \
    --manifest-path "$SRCDIR/vm_tools/carte/Cargo.toml" \
    --target-dir "$work/carte-target" \
    --bin carte-agent
install -D -m 0755 "$work/carte-target/release/carte-agent" "$DESTDIR/usr/local/bin/carte-agent"
