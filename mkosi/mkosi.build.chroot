#!/bin/bash
# Builds the guest packages (sommelier and garnish-guest, see guest/) for
# the target distribution. Runs inside the image (with BuildPackages=
# overlaid), so they're built with the distribution's own tools and
# libraries.
#
# The packages go to $PACKAGEDIR, mkosi's local repository, from which
# VolatilePackages= in mkosi.conf installs them, and to
# mkosi.output/packages-<distribution>/, for guest/update-guest.sh.
set -euo pipefail

# mkosi (27.1) gives build scripts no $OUTPUTDIR, and with `-t none` it
# stops right after them, so nothing later could copy the packages out.
# Write them through the repository mount instead (BuildSources=..), to
# OutputDirectory= from mkosi.conf.
out="$SRCDIR/mkosi/mkosi.output/packages-$DISTRIBUTION"
rm -rf "$out"

"$SRCDIR/guest/build-packages.sh" "$PACKAGEDIR" "$out"
