#compdef carte

# The VMs with launchers: ~/.local/share/applications/carte-<vm>.<id>.desktop
_carte_vms() {
  local -a files vms
  files=(${XDG_DATA_HOME:-$HOME/.local/share}/applications/carte-*.*.desktop(N.:t))
  files=(${files#carte-})
  vms=(${(u)files%%.*})
  _describe -t vms 'VM' vms
}

# The applications of a VM, by ID
_carte_apps() {
  local -a apps
  apps=(${XDG_DATA_HOME:-$HOME/.local/share}/applications/carte-$1.*.desktop(N.:t:r))
  apps=(${apps#carte-$1.})
  _describe -t apps 'application' apps
}

# The applications a VM has taken out of the menu
_carte_hidden() {
  local f=${XDG_CONFIG_HOME:-$HOME/.config}/carte/$1.hidden
  local -a apps
  [[ -f $f ]] && apps=(${(f)"$(grep -v '^#' $f)"})
  _describe -t apps 'hidden application' apps
}

_carte() {
  local -a subcommands
  subcommands=(
    'sync:put the applications of a VM in the menu and keep them up to date'
    'launch:start an application in a running VM'
    'hide:take an application out of the menu'
    'show:put a hidden application back in the menu'
    'remove:remove the applications of a VM from the menu'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'carte command' subcommands
    return
  fi

  case $words[2] in
    sync)
      case $CURRENT in
        3) compadd -- --cid ;;
        4) _message 'vsock CID' ;;
        5) compadd -- --no-menu ;;
      esac
      ;;
    launch|hide)
      # launch --no-notify <vm> <id>
      local i=3
      [[ $words[2] == launch && $words[3] == --no-notify ]] && i=4
      if (( CURRENT == i )); then
        _carte_vms
        [[ $words[2] == launch && $i == 3 ]] && compadd -- --no-notify
      elif (( CURRENT == i + 1 )); then
        _carte_apps $words[i]
      fi
      ;;
    show)
      case $CURRENT in
        3) _carte_vms ;;
        4) _carte_hidden $words[3] ;;
      esac
      ;;
    remove)
      (( CURRENT == 3 )) && _carte_vms
      ;;
  esac
}

_carte "$@"
