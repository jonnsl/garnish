<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="salle">
  <schema id="@APP_ID@" path="/org/garnish/Salle/">
    <key name="window-width" type="i">
      <default>900</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="last-selected" type="s">
      <default>''</default>
      <summary>Name of the virtual machine selected when the window was last closed</summary>
    </key>
    <key name="image-folder" type="s">
      <default>''</default>
      <summary>Folder the last disk image was chosen from</summary>
      <description>Where the file chooser for a new virtual machine’s image opens</description>
    </key>
  </schema>
</schemalist>
