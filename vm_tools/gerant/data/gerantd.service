[Unit]
Description=gerant: crosvm VM manager

[Service]
Type=dbus
BusName=org.garnish.Gerant
ExecStart=%h/.cargo/bin/gerantd
# crosvm, vhost-device-sound and carte are looked up in $PATH, and carte is
# usually installed with cargo.
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin
# gerantd shuts the guests down itself: power button, then crosvm stop after
# StopTimeoutSec= (30s by default). KillMode=mixed sends SIGTERM to gerantd
# alone; with the default, crosvm would get it too and die on the spot.
KillMode=mixed
TimeoutStopSec=60
