# carte, the host side of the app menu: launchers for the guests' applications.
# Build and install with: makepkg -si
# Built from the working tree in vm_tools/carte, not from a download, so it
# picks up uncommitted changes. carte-agent is left out: it runs in the guest,
# and the images build their own.

pkgname=carte
pkgver=0.1.0
pkgrel=1
pkgdesc="Shows the applications of crosvm guests in the host's application menu"
arch=(x86_64)
url='https://github.com/jonnsl/garnish'
license=(GPL-3.0-or-later)
depends=(gcc-libs glibc)
makedepends=(cargo)
# Cargo.toml strips the release binaries, so a debug package would be empty.
options=(!debug)
optdepends=('libnotify: notification when a launcher is started while its VM is off'
            'maitre: runs carte sync for every VM it starts')

_src="$startdir/../../vm_tools/$pkgname"

prepare() {
  local version
  version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$_src/Cargo.toml")
  if [[ $version != "$pkgver" ]]; then
    error "pkgver is $pkgver, but Cargo.toml says $version"
    return 1
  fi
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --manifest-path "$_src/Cargo.toml" \
    --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release --manifest-path "$_src/Cargo.toml" --bin carte
}

check() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --manifest-path "$_src/Cargo.toml"
}

package() {
  install -Dm755 "$srcdir/target/release/carte" "$pkgdir/usr/bin/carte"
  install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
