# The host side of garnish, as two packages from one build:
# - garnish-host: gerantd, the D-Bus VM manager, and gerant, its client;
#   gerant-net, the setuid-root helper that creates the VMs' network devices;
#   carte, the host side of the app menu; sonnette, which shows the
#   guests' notifications; and videur, which restricts their clipboard
# - salle: the GTK app for gerantd's VMs, separate so the command line tools
#   don't pull in GTK
# Build and install both with: makepkg -si
# Built from the working tree in vm_tools/, not from a download, so it picks
# up uncommitted changes. carte-agent and sonnette-agent are left out: they
# run in the guest, and come with the garnish-guest package (guest/). The user unit is installed
# with ExecStart=/usr/bin/gerantd; its PATH still has ~/.cargo/bin and
# ~/.local/bin for crosvm.

pkgbase=garnish
pkgname=(garnish-host salle)
pkgver=0.1.0
pkgrel=1
arch=(x86_64 aarch64)
url='https://github.com/jonnsl/garnish'
license=(GPL-3.0-or-later)
makedepends=(cargo meson vala blueprint-compiler glib2 gtk4 libadwaita libpulse json-glib)
checkdepends=(appstream desktop-file-utils)

_tools="$startdir/../../vm_tools"

# The version in each project's build file has to match pkgver.
_check_version() {
  local file=$1 pattern=$2 version
  version=$(sed -n "$pattern" "$file" | head -n1)
  if [[ $version != "$pkgver" ]]; then
    error "pkgver is $pkgver, but $file says $version"
    return 1
  fi
}

prepare() {
  _check_version "$_tools/gerant/Cargo.toml" 's/^version = "\(.*\)"$/\1/p'
  _check_version "$_tools/carte/Cargo.toml" 's/^version = "\(.*\)"$/\1/p'
  _check_version "$_tools/sonnette/Cargo.toml" 's/^version = "\(.*\)"$/\1/p'
  _check_version "$_tools/videur/Cargo.toml" 's/^version = "\(.*\)"$/\1/p'
  _check_version "$_tools/salle/meson.build" "s/^ *version: *'\([^']*\)'.*/\1/p"

  export RUSTUP_TOOLCHAIN=stable
  local target
  target=$(rustc -vV | sed -n 's/host: //p')
  for project in gerant carte sonnette videur; do
    cargo fetch --locked --manifest-path "$_tools/$project/Cargo.toml" --target "$target"
  done
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release --manifest-path "$_tools/gerant/Cargo.toml"
  cargo build --frozen --release --manifest-path "$_tools/carte/Cargo.toml" --bin carte
  cargo build --frozen --release --manifest-path "$_tools/sonnette/Cargo.toml" --bin sonnette
  cargo build --frozen --release --manifest-path "$_tools/videur/Cargo.toml"

  arch-meson "$_tools/salle" salle-build -Dprofile=default
  meson compile -C salle-build
}

check() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --manifest-path "$_tools/gerant/Cargo.toml"
  cargo test --frozen --manifest-path "$_tools/carte/Cargo.toml"
  cargo test --frozen --manifest-path "$_tools/sonnette/Cargo.toml"
  cargo test --frozen --manifest-path "$_tools/videur/Cargo.toml"
  meson test -C salle-build --print-errorlogs
}

package_garnish-host() {
  pkgdesc='Runs crosvm guests for the user over D-Bus, with their applications in the host menu and their notifications on the desktop'
  # passt: [Network] Mode=passt, the default. wayland, wayland-protocols:
  # the protocol descriptions videur reads.
  depends=(gcc-libs glibc passt wayland wayland-protocols)
  optdepends=('crosvm: runs the VMs (needed, but often built by hand)'
              'vhost-device-sound: Audio=yes (host/vhost-device-sound, with --no-capture)'
              'openssh: gerant ssh'
              'libnotify: notification when a launcher is started while its VM is off')
  # Formerly separate packages.
  provides=(gerant carte)
  conflicts=(gerant carte)
  replaces=(gerant carte)
  install=garnish-host.install
  # Cargo.toml strips the release binaries, so a debug package would be empty.
  options=(!debug)

  local gerant="$_tools/gerant" carte="$_tools/carte" sonnette="$_tools/sonnette" videur="$_tools/videur"
  install -Dm755 "$srcdir"/target/release/{gerantd,gerant,carte,sonnette,videur} -t "$pkgdir/usr/bin/"
  # setuid root: it drops everything but CAP_NET_ADMIN and seccomp-confines
  # itself before doing anything (vm_tools/gerant/src/bin/gerant-net).
  install -Dm4755 "$srcdir/target/release/gerant-net" -t "$pkgdir/usr/bin/"
  install -Dm644 "$gerant/data/10-garnish.network" -t "$pkgdir/usr/lib/systemd/network/"
  install -Dm644 "$gerant/data/gerantd.service" "$pkgdir/usr/lib/systemd/user/gerantd.service"
  sed -i 's|^ExecStart=.*|ExecStart=/usr/bin/gerantd|' "$pkgdir/usr/lib/systemd/user/gerantd.service"
  install -Dm644 "$gerant/data/org.garnish.Gerant.service" -t "$pkgdir/usr/share/dbus-1/services/"

  install -Dm644 "$gerant/completions/gerant.bash" "$pkgdir/usr/share/bash-completion/completions/gerant"
  install -Dm644 "$carte/completions/carte.bash" "$pkgdir/usr/share/bash-completion/completions/carte"
  install -Dm644 "$gerant/completions/_gerant" "$carte/completions/_carte" -t "$pkgdir/usr/share/zsh/site-functions/"

  install -Dm644 "$gerant/README.md" "$pkgdir/usr/share/doc/gerant/README.md"
  install -Dm644 "$gerant"/examples/*.conf -t "$pkgdir/usr/share/doc/gerant/examples/"
  install -Dm644 "$carte/README.md" "$pkgdir/usr/share/doc/carte/README.md"
  install -Dm644 "$sonnette/README.md" "$pkgdir/usr/share/doc/sonnette/README.md"
  install -Dm644 "$videur/README.md" "$pkgdir/usr/share/doc/videur/README.md"
}

package_salle() {
  pkgdesc='Create, configure, start and stop crosvm virtual machines run by gerantd'
  depends=(glib2 gtk4 libadwaita libpulse json-glib hicolor-icon-theme)
  optdepends=('garnish-host: runs the VMs (needed)'
              'openssh: connect to the VMs'
              'xdg-terminal-exec: open a terminal with ssh into a VM')

  meson install -C "$srcdir/salle-build" --destdir "$pkgdir"
}
