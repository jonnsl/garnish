_reload_note() {
  echo '>>> The session bus only reads D-Bus service files when it starts or reloads.'
  echo '>>> Log out and back in, or run as your user:'
  echo '>>>   busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig'
}

# For 10-garnish.network, if systemd-networkd runs.
_networkd_reload() {
  networkctl reload 2>/dev/null || true
}

post_install() {
  _networkd_reload
  _reload_note
  echo '>>> Example VM configuration: /usr/share/doc/gerant/examples/debian.conf'
}

post_remove() {
  # gerant-net's firewall rules; the taps went with the VMs.
  nft delete table ip garnish 2>/dev/null || true
}

post_upgrade() {
  _networkd_reload
  echo '>>> Restart gerantd to use the new version: systemctl --user restart gerantd'
  echo '>>> (this shuts down running VMs)'
}
