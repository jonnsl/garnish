# garnish-guest for garnish's Arch guests: carte-agent, sonnette-agent,
# gerant-ready and the Wayland environment.
# Don't run makepkg here: ../build-packages.sh fills in @VERSION@ and
# @RELEASE@ from ../versions, makes the source tarball and fetches the
# crates, then builds this in a copy.

pkgname=garnish-guest
pkgver=@VERSION@
pkgrel=@RELEASE@
pkgdesc="Guest side of garnish: carte-agent, sonnette-agent, boot notification for gerantd, Wayland environment"
arch=(x86_64)
url='https://github.com/jonnsl/garnish'
license=(GPL-3.0-or-later)
depends=(dbus glibc libgcc sommelier systemd)
# sonnette-agent is the notification server.
provides=(notification-daemon)
makedepends=(cargo)
options=(!debug)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=(SKIP)

build() {
  cd "$pkgname-$pkgver"
  cargo build --frozen --release --manifest-path carte/Cargo.toml \
    --target-dir "$srcdir/target" --bin carte-agent
  cargo build --frozen --release --manifest-path sonnette/Cargo.toml \
    --target-dir "$srcdir/target" --bin sonnette-agent
}

package() {
  cd "$pkgname-$pkgver"
  ./install.sh "$pkgdir" "$srcdir/target/release/carte-agent" "$srcdir/target/release/sonnette-agent"
}
