#!/bin/bash
# Creates the guest user and wires up sommelier, sudo and sshd-vsock.
set -euo pipefail

: "${GUEST_USER:=jonnathan}"
: "${GUEST_PASSWORD:=}"
: "${PASSWORDLESS_SUDO:=yes}"
: "${GUEST_ADDRESS:=192.168.10.2/24}"
: "${GUEST_GATEWAY:=192.168.10.1}"
: "${GUEST_DNS:=1.1.1.1,9.9.9.9}"

is_true() {
    case "${1,,}" in
        1|y|yes|true|on) return 0 ;;
        *) return 1 ;;
    esac
}

# --- groups -----------------------------------------------------------------
# video/render are needed for /dev/dri access by sommelier. systemd-sysusers
# normally creates them, but it only runs after this script.
for g in video render; do
    getent group "$g" >/dev/null || groupadd --system "$g"
done

# Debian/Ubuntu use "sudo", Arch/Fedora use "wheel".
if getent group sudo >/dev/null; then
    admin_group=sudo
else
    getent group wheel >/dev/null || groupadd --system wheel
    admin_group=wheel
fi

# --- user -------------------------------------------------------------------
if ! id "$GUEST_USER" >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --user-group \
        --groups "video,render,$admin_group" "$GUEST_USER"
else
    usermod --append --groups "video,render,$admin_group" "$GUEST_USER"
fi

if [[ -n "$GUEST_PASSWORD" ]]; then
    echo "$GUEST_USER:$GUEST_PASSWORD" | chpasswd
else
    # No password: no console login and no sudo unless PASSWORDLESS_SUDO=yes.
    usermod --password '*' "$GUEST_USER"
fi

home="$(getent passwd "$GUEST_USER" | cut -d: -f6)"

# --- sudo -------------------------------------------------------------------
# Per-user rule, so it works regardless of whether the distro's sudoers
# enables %wheel / %sudo (Arch ships it commented out).
if is_true "$PASSWORDLESS_SUDO"; then
    rule="$GUEST_USER ALL=(ALL:ALL) NOPASSWD: ALL"
else
    rule="$GUEST_USER ALL=(ALL:ALL) ALL"
fi
install -d -m 0750 /etc/sudoers.d
echo "$rule" > /etc/sudoers.d/10-guest-user
chmod 0440 /etc/sudoers.d/10-guest-user

# --- ssh --------------------------------------------------------------------
# Outside $home so a shared home directory doesn't hide it (see 10-crosvm.conf).
if [[ -f "$SRCDIR/authorized_keys" ]]; then
    install -d -m 0755 /etc/ssh/authorized_keys.d
    install -m 0644 "$SRCDIR/authorized_keys" "/etc/ssh/authorized_keys.d/$GUEST_USER"
else
    # sshd only accepts keys (mkosi.extra/etc/ssh/sshd_config.d/10-crosvm.conf).
    echo "WARNING: no authorized_keys in the project directory, ssh login will be impossible" >&2
fi

# Don't bake host keys into the image (Debian/Ubuntu generate them at
# package install time); sshd-vsock@.service runs ssh-keygen -A on demand.
rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub

systemctl enable sshd-vsock.socket

# --- package manager ----------------------------------------------------------
# pacman-mirrorlist ships with every server commented out, and mkosi only
# configures its mirror for the build itself. Use the same mirror mkosi uses
# by default, plus the GeoIP redirector as a fallback.
if [[ "$DISTRIBUTION" == arch ]] && ! grep -q '^[[:space:]]*Server' /etc/pacman.d/mirrorlist 2>/dev/null; then
    cat > /etc/pacman.d/mirrorlist <<'MIRRORS'
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
MIRRORS
fi

# The pacman keyring is left uninitialized (mkosi uses its own for the build).
# Create it on first boot rather than here so images don't share a local
# signing key, like archiso's pacman-init.service.
if [[ "$DISTRIBUTION" == arch ]]; then
    cat > /etc/systemd/system/pacman-init.service <<'UNIT'
[Unit]
Description=Initialize the pacman keyring
ConditionDirectoryNotEmpty=!/etc/pacman.d/gnupg
After=time-sync.target
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/bin/pacman-key --init
ExecStart=/usr/bin/pacman-key --populate

[Install]
WantedBy=multi-user.target
UNIT
    systemctl enable pacman-init.service
fi

# --- network ----------------------------------------------------------------
# Static address on the crosvm tap (see setup-host-net.sh for the host side).
install -d /etc/systemd/network
{
    echo "[Match]"
    echo "Type=ether"
    echo
    echo "[Network]"
    echo "Address=$GUEST_ADDRESS"
    echo "Gateway=$GUEST_GATEWAY"
    IFS=, read -ra dns_servers <<<"$GUEST_DNS"
    for dns in "${dns_servers[@]}"; do
        echo "DNS=$dns"
    done
} > /etc/systemd/network/80-crosvm-tap.network

# /etc/resolv.conf -> resolved stub is set up in mkosi.finalize: here it is a
# read-only bind mount of the host's file (WithNetwork=yes).
systemctl enable systemd-networkd.service systemd-resolved.service

# --- sommelier user service -------------------------------------------------
# Like everything below, this stays out of $home so the image keeps working
# when run-crosvm.sh mounts a host directory over it (SHARE_HOME=).
unit_dir=/etc/systemd/user
install -d "$unit_dir/default.target.wants"
cat > "$unit_dir/sommelier.service" <<'UNIT'
[Unit]
Description=Sommelier Wayland proxy

[Service]
ExecStart=/usr/local/bin/sommelier --parent --socket=wayland-0 --virtgpu-channel
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
# Equivalent of `systemctl --global enable sommelier`.
ln -sf ../sommelier.service "$unit_dir/default.target.wants/sommelier.service"

# Equivalent of `loginctl enable-linger $GUEST_USER`: start the user manager
# (and thus sommelier) at boot without needing a login.
install -d /var/lib/systemd/linger
touch "/var/lib/systemd/linger/$GUEST_USER"

# --- shell environment ------------------------------------------------------
# /etc/profile sources this for login shells on all four distros.
cat > /etc/profile.d/crosvm-wayland.sh <<'PROFILE'
export WAYLAND_DISPLAY=wayland-0
export MOZ_ENABLE_WAYLAND=1
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
# Electron/Chromium (VS Code, ...) pick their backend from this. logind sets
# it to "tty" for ssh logins, so they try X11, find no $DISPLAY and quit.
export XDG_SESSION_TYPE=wayland
PROFILE

# --- home ownership ---------------------------------------------------------
# Rootless mkosi maps only a single user (root) into the build, so chown to
# $GUEST_USER fails here and everything above is owned by root. Hand the home
# directory over on first boot instead, before any user session starts.
# (A tmpfiles.d rule won't do: mkosi runs tmpfiles at build time, too.)
# Skip it while a host directory is mounted there: chown would walk the host
# files, and the image's own home is hidden anyway.
home_mount="$(systemd-escape --path --suffix=mount "$home")"
cat > /etc/systemd/system/guest-home-owner.service <<UNIT
[Unit]
Description=Give $GUEST_USER ownership of $home
ConditionPathExists=!/var/lib/guest-home-owner/done
ConditionPathIsMountPoint=!$home
After=local-fs.target $home_mount
Before=systemd-user-sessions.service

[Service]
Type=oneshot
StateDirectory=guest-home-owner
ExecStart=/usr/bin/chown -R $GUEST_USER:$GUEST_USER $home
ExecStart=/usr/bin/touch /var/lib/guest-home-owner/done

[Install]
WantedBy=multi-user.target
UNIT
systemctl enable guest-home-owner.service
